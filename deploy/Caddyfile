# sshfighter.com — reverse proxy + automatic HTTPS. Reached through the Fly relay
# (raw TCP passthrough on 80/443); Caddy terminates TLS and answers ACME here.
sshfighter.com {
	encode zstd gzip

	# Web app (Next.js on :3130) owns these /api paths: sprite/stage images and
	# the sprite-gallery admin. These come BEFORE the catch-all so they win.
	handle /api/sprite/* {
		reverse_proxy localhost:3130
	}
	handle /api/stage/* {
		reverse_proxy localhost:3130
	}
	handle /api/projectile/* {
		reverse_proxy localhost:3130
	}
	handle /api/status {
		reverse_proxy localhost:3130
	}
	handle /api/regenerate {
		reverse_proxy localhost:3130
	}

	# Public game build identity (engine family + exact source commit).
	handle /version {
		reverse_proxy localhost:8080
	}

	# Everything else under /api/* is the Ringside game API (primary on :8080):
	# live, matches, players, leaderboard, characters, matchups, stats, ops, replay.
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# The web homepage app.
	handle {
		reverse_proxy localhost:3130
	}
}
