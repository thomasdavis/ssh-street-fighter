[Unit]
Description=sshfighter.com — terminal versus fighting game over SSH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/sshfighter.env
# Run the game. tsx runs the TypeScript directly (matches dev). Invoked via
# node + the tsx CLI (not `pnpm exec`, which pnpm 10+ gates behind a build-
# approval check). Swap to `node dist/index.js` after a build for a perf win.
ExecStart=/usr/bin/env node node_modules/tsx/dist/cli.mjs src/index.ts
Restart=always
RestartSec=2

# Bind port 22 without running as root: grant just the one capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Light hardening (the game only needs its own dir + /etc/sshfighter.env).
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

# Give the event loop headroom; keep it off the box's other work if shared.
Nice=-5

[Install]
WantedBy=multi-user.target
