global
    log stdout format raw local0
    maxconn 8000
defaults
    mode tcp
    log global
    option tcplog
    timeout connect 5s
    timeout client 1h      # generous idle window; the game's keepalive covers NAT
    timeout server 1h
frontend ssh_in
    bind :2222
    default_backend origin
backend origin
    # send-proxy: prepend a PROXY v1 header so the origin recovers the real
    # client IP (region matchmaking + telemetry). The origin runs with
    # SF_PROXY_PROTOCOL=1 to read it.
    server ovh ${ORIGIN_HOST}:${ORIGIN_PORT} check send-proxy

# Web (homepage + Ringside API). Raw TCP passthrough to the origin's Caddy, which
# terminates TLS end-to-end and answers ACME challenges. No send-proxy here —
# Caddy isn't configured to read a PROXY header on 80/443.
frontend http_in
    bind :8080
    default_backend origin_web
backend origin_web
    server ovh_web ${ORIGIN_HOST}:80 check
frontend https_in
    bind :8443
    default_backend origin_https
backend origin_https
    server ovh_https ${ORIGIN_HOST}:443 check
