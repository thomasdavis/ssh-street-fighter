# Core SSH server
SF_HOST=0.0.0.0
SF_PORT=2223
SF_DB=data/streetfighter.db

# Optional immutable source revision for builds without a readable .git checkout.
# The server falls back to `git rev-parse HEAD` when this is unset.
# SF_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567
# SF_BUILD_DIRTY=false

# Keep full truecolor by leaving these at their defaults.
SF_COLOR_STEP=1
# SF_COLOR_MODE=256

# Optional integrations. Never commit real values.
# SF_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# SF_GALLERY_ADMIN_TOKEN=replace-me
# OPENAI_API_KEY=replace-me
